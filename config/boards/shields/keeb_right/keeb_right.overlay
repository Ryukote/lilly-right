/*
 * Pretpostavljeni raspored pinova na SuperMini nRF52840 pločici
 * (na temelju slike - PROVJERI nakon prvog flasha!):
 *
 * REDOVI (5, lijeva strana pločice):
 *   row0 = P0.10   row1 = P1.11   row2 = P1.13
 *   row3 = P1.15   row4 = P0.02  (thumb red)
 *
 * KOLONE (6, desna strana pločice):
 *   col0 = P1.04   col1 = P1.10   col2 = P1.00
 *   col3 = P0.24   col4 = P0.22   col5 = P0.17
 *
 * Ako NIJEDNA tipka ne radi nakon flasha -> zamijeni
 * diode-direction "col2row" u "row2col" ispod.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&gpio1 4  GPIO_ACTIVE_HIGH>
            , <&gpio1 10 GPIO_ACTIVE_HIGH>
            , <&gpio1 0  GPIO_ACTIVE_HIGH>
            , <&gpio0 24 GPIO_ACTIVE_HIGH>
            , <&gpio0 22 GPIO_ACTIVE_HIGH>
            , <&gpio0 17 GPIO_ACTIVE_HIGH>
            ;
    };

    /*
     * Fizički raspored tipki (28 ukupno):
     * red0: 6 7 8 9 0 Š          (broj red)
     * red1: Z U I O P Đ
     * red2: H J K L Č Ć
     * red3: N M ; : - Ž
     * red4:       strelice (Left Up Down Right) - pod col2-5
     *
     * Ako je redoslijed tipki u keymapu krivo poravnat sa
     * stvarnom fizičkom tipkom, ovdje se to popravlja
     * (ne treba dirati kscan pinove gore).
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;
        rows = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
                            RC(4,2) RC(4,3) RC(4,4) RC(4,5)
        >;
    };
};
